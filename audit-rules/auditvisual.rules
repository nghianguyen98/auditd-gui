# AuditVisual audit rules
# Track tất cả lệnh thực thi (kể cả sau sudo -i)
# AUID = loginuid, không đổi dù escalate privilege
#
# PRODUCTION SAFETY:
#   -F auid>=1000        → chỉ track user thực, bỏ qua system/daemon (giảm ~80% log volume)
#   -F auid!=4294967295  → bỏ qua unset AUID (kernel process)

# ─── Lệnh thực thi (chỉ user thực, không track system/daemon) ────────────────
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=4294967295 -k cmd_exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=4294967295 -k cmd_exec

# ─── Escalation (sudo, su) ─────────────────────────────────────────────────────
-w /usr/bin/sudo -p x -k sudo_cmd
-w /usr/bin/su -p x -k su_cmd
-w /bin/su -p x -k su_cmd

# ─── File nhạy cảm ────────────────────────────────────────────────────────────
-w /etc/passwd -p rwxa -k passwd_change
-w /etc/shadow -p rwxa -k shadow_access
-w /etc/sudoers -p rwxa -k sudoers_change
-w /etc/sudoers.d/ -p rwxa -k sudoers_change
-w /etc/ssh/sshd_config -p rwxa -k sshd_config
-w /root/ -p rwxa -k root_access
-w /root/.ssh/ -p rwxa -k root_ssh

# ─── Cron & scheduled tasks ────────────────────────────────────────────────────
-w /etc/cron.d/ -p rwxa -k cron_change
-w /etc/crontab -p rwxa -k cron_change
-w /var/spool/cron/ -p rwxa -k cron_change

# ─── Log files (detect log tampering) ─────────────────────────────────────────
-w /var/log/ -p wa -k log_access

# ─── Network tools ────────────────────────────────────────────────────────────
-w /usr/bin/nc -p x -k netcat
-w /usr/bin/ncat -p x -k netcat
-w /usr/bin/wget -p x -k download_tool
-w /usr/bin/curl -p x -k download_tool

# ─── Login/logout ────────────────────────────────────────────────────────────
-w /var/log/lastlog -p wa -k login_logout
-w /var/run/faillock/ -p wa -k login_logout
-w /var/run/utmp -p wa -k login_logout
