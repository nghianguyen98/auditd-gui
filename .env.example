# Auditd GUI Environment Configuration
# Copy this file to .env and fill in the actual values

# ===== AUTH =====
# The first admin account (automatically created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2024!

# JWT Secret - MUST be changed to a random string of at least 64 characters
# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-at-least-64-characters-long

# Token expiration in hours
JWT_EXPIRE_HOURS=8

# Node API Key - Used for secure communication between collector nodes and central API
# Generate: openssl rand -hex 16
NODE_API_KEY=change-this-to-a-random-secret-for-nodes


# ===== PORTS =====
# Web UI port (default: 7432)
WEB_PORT=7432

# Internal API port (default: 7433)
API_PORT=7433

# ===== HOST LOG PATHS =====
# Path to audit log on the host (usually no need to change)
HOST_AUDIT_LOG=/var/log/audit/audit.log

# Path to auth log on the host
# Ubuntu/Debian: /var/log/auth.log
# RHEL/CentOS/Fedora: /var/log/secure
HOST_AUTH_LOG=/var/log/auth.log
